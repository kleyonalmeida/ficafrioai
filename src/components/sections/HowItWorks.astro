---
import { steps } from '../../data/landing';
import ColdScene from './ColdScene.astro';
---

<section id="como-funciona" class="section section-white" aria-labelledby="flow-title">
  <ColdScene />
  <div class="container">
    <ol class="service-timeline" data-service-timeline>
      {steps.map(({ title, text, tag }, index) => (
        <li class="timeline-step">
          {index < steps.length - 1 && (
            <span class="timeline-rail" aria-hidden="true"><span class="timeline-fill"></span></span>
          )}
          <span class="timeline-marker" aria-hidden="true">0{index + 1}</span>
          <article class="card timeline-card">
            <p class="timeline-role">{tag}</p>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const timeline = document.querySelector('[data-service-timeline]');
  if (timeline) {
    const steps = Array.from(timeline.querySelectorAll('.timeline-step'));
    const media = gsap.matchMedia();

    media.add('(prefers-reduced-motion: no-preference)', () => {
      steps.forEach((step, index) => {
        const card = step.querySelector('.timeline-card');
        const fill = step.querySelector('.timeline-fill');
        const next = steps[index + 1];

        gsap.from(card, {
          y: 12,
          opacity: 0.72,
          duration: 0.45,
          ease: 'power2.out',
          scrollTrigger: { trigger: step, start: 'top 88%', once: true },
        });

        if (fill && next) {
          // Cada trecho cresce do centro de um marcador ao centro do próximo.
          gsap.to(fill, {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: step,
              start: '22px 60%',
              endTrigger: next,
              end: '22px 60%',
              scrub: true,
            },
          });
        }
      });
    });
  }
</script>

<style>
  #como-funciona {
    background: radial-gradient(ellipse at 25% 4rem, #0b2231, transparent 50%),
      linear-gradient(var(--app-bg), var(--surface) 28rem);
  }

  .service-timeline {
    --marker-radius: 22px;
    --row-gap: clamp(0.875rem, 2vw, 1.25rem);
    display: grid;
    gap: var(--row-gap);
    max-width: 57rem;
    margin-inline: auto;
    padding: 0;
    list-style: none;
  }

  .timeline-step {
    --axis: 50%;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(2 * var(--marker-radius)) minmax(0, 1fr);
    column-gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
  }

  .timeline-rail {
    position: absolute;
    inset-block-start: var(--marker-radius);
    inset-inline-start: calc(var(--axis) - 1px);
    width: 2px;
    height: calc(100% + var(--row-gap));
    background: var(--border);
  }

  .timeline-fill {
    display: block;
    height: 100%;
    background: var(--primary);
    transform: scaleY(0);
    transform-origin: top;
  }

  .timeline-marker {
    position: relative;
    z-index: 1;
    grid-area: 1 / 2;
    display: grid;
    place-items: center;
    width: calc(2 * var(--marker-radius));
    aspect-ratio: 1;
    border: 1px solid var(--primary);
    border-radius: 50%;
    background: var(--info-bg);
    color: var(--primary-hover);
    font-size: 0.875rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .timeline-card {
    grid-area: 1 / 1;
    background: var(--app-bg);
    text-align: end;
  }

  .timeline-step:nth-child(even) .timeline-card {
    grid-column: 3;
    text-align: start;
  }

  .timeline-card .timeline-role {
    margin-block-end: 0.375rem;
    color: var(--primary-hover);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .timeline-step {
      --axis: var(--marker-radius);
      grid-template-columns: calc(2 * var(--marker-radius)) minmax(0, 1fr);
      column-gap: 0.75rem;
    }

    .timeline-marker { grid-column: 1; }

    .timeline-card, .timeline-step:nth-child(even) .timeline-card {
      grid-column: 2;
      text-align: start;
    }
  }
</style>
